# Copy to .env and fill in. Never commit .env. (PLAN.md Deltas 4, 5, 9)

# Supabase: jobs and API use Postgres over the session pooler; the web app uses the publishable key.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_DB_URL=
# Local development falls back to postgresql:///finn_dev when SUPABASE_DB_URL is empty.
FINN_DB_URL=

# Web (derived from the two Supabase values above by scripts/sync_env.sh)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Deploy
VERCEL_TOKEN=
HF_TOKEN=

# LLMs: cheap tier for extraction, strong tier for P9–P11 only. Prices are ₹ per million tokens.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
FINN_CHEAP_MODEL=gemini-2.5-flash
FINN_STRONG_MODEL=claude-sonnet-5
FINN_PROMPT_VERSION=v1
FINN_CHEAP_IN=0
FINN_CHEAP_OUT=0
FINN_STRONG_IN=0
FINN_STRONG_OUT=0

# Push
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TAVILY_API_KEY=
FINN_USE_NSE=1
FINN_USE_BSE=0

# Runtime
FINN_CACHE=.cache
TZ=Asia/Kolkata
